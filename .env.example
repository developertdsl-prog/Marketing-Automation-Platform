# ============================================================
# Marketing Automation Platform - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit real secrets to version control.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# --- Database (PostgreSQL) ---
# Example: postgresql://postgres:postgres@localhost:5432/marketing_automation?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketing_automation?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketing_automation
POSTGRES_PORT=5432

# --- Cache & Job Queue (Redis) ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Authentication (JWT) ---
# Generate strong secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Email Provider (choose one) ---
# SendGrid
SENDGRID_API_KEY=
# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# AWS SES
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- Third-Party Integrations ---
WEBHOOK_SECRET=

# --- Integration Encryption Key ---
# Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=change-me-integration-encryption-key-32-chars

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Ports ---
API_PORT=3001
APP_PORT=3000

# End of file