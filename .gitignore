# ============================================================
# Marketing Automation Platform - .gitignore
# ============================================================

# --- Node.js ---
node_modules/
.npm
.yarn-integrity
.pnp
.pnp.js
*.tsbuildinfo

# --- Build outputs ---
dist/
build/
.next/
out/
.nuxt/
*.local

# --- Environment variables (never commit real secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Coverage ---
coverage/
.nyc_output/

# --- Docker ---
.docker/

# --- Misc ---
.turbo/
.cache/
.vite/

# Test artifacts
coverage/
playwright-report/
test-results/
playwright/.cache/

# End of file