// ============================================================
// Marketing Automation Platform - Prisma Schema
// Multi-tenant, normalized relational database
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Core: Organizations & Users (tenant isolation)
// --------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  teams                Team[]
  contacts             Contact[]
  leads                Lead[]
  campaigns            Campaign[]
  emailTemplates       EmailTemplate[]
  automationWorkflows  AutomationWorkflow[]
  integrations         Integration[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  roles                Role[]
  contactTags          ContactTag[]
  contactSegments      ContactSegment[]
  emailEvents          EmailEvent[]
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String   @db.Uuid
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId        String?   @db.Uuid
  role          Role      @relation(fields: [roleId], references: [id])
  roleId        String    @db.Uuid
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contacts      Contact[]
  leads         Lead[]
  campaigns     Campaign[]
  notifications Notification[]
  auditLogs     AuditLog[]
  automationWorkflows AutomationWorkflow[]

  @@index([organizationId])
  @@index([email])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  name        String   // e.g. admin, manager, member, viewer
  key         String   @unique // e.g. ORG_ADMIN, CAMPAIGN_MANAGER
  description String?
  permissions Json     @default("[]") // stored as array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([organizationId])
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  leads       Lead[]

  @@index([organizationId])
}

// --------------------------------------------------------------------------
// Contacts
// --------------------------------------------------------------------------

model Contact {
  id            String      @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String      @db.Uuid
  email         String      @unique
  firstName     String?
  lastName      String?
  phone         String?
  company       String?
  jobTitle      String?
  city          String?
  country       String?
  customFields  Json        @default("{}") // flexible extra attributes
  isUnsubscribed Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tags          ContactTag[]
  segments      ContactSegment[]
  campaignRecipients CampaignRecipient[]
  emailEvents   EmailEvent[]
  leads         Lead[]
  workflowExecutions WorkflowExecution[]
  createdBy     User?     @relation(fields: [createdById], references: [id])
  createdById   String?   @db.Uuid

  @@index([organizationId])
  @@index([email])
}

model ContactTag {
  id          String   @id @default(uuid()) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String   @db.Uuid
  tag         String
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([tag])
}

model ContactSegment {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  name          String
  rules         Json     // segment filter rules (JSON)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts      Contact[]
  campaigns     Campaign[]

  @@index([organizationId])
}

// --------------------------------------------------------------------------
// Leads
// --------------------------------------------------------------------------

model Lead {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     String   @db.Uuid
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId        String?  @db.Uuid
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId       String?  @db.Uuid
  status        String   @default("new") // new, contacted, qualified, converted, lost
  score         Int      @default(0)
  source        String?
  value         Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([status])
  @@index([score])
}

// --------------------------------------------------------------------------
// Campaigns
// --------------------------------------------------------------------------

model Campaign {
  id             String      @id @default(uuid()) @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String      @db.Uuid
  name           String
  description    String?
  type           String      @default("email") // email, sms, mixed
  status         String      @default("draft") // draft, scheduled, active, paused, completed, cancelled
  scheduleAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  emailTemplate  EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  emailTemplateId String?     @db.Uuid
  segment        ContactSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  segmentId      String?       @db.Uuid
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  recipients     CampaignRecipient[]
  emailEvents    EmailEvent[]

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
}

// --------------------------------------------------------------------------
// Email Templates & Events
// --------------------------------------------------------------------------

model EmailTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  name          String
  subject       String
  htmlContent   String
  textContent   String?
  variables     Json     @default("{}") // available merge variables
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     Campaign[]
  emailEvents   EmailEvent[]

  @@index([organizationId])
}

model EmailEvent {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId    String   @db.Uuid
  emailTemplate EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  emailTemplateId String?  @db.Uuid
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     String   @db.Uuid
  type          String   // sent, delivered, opened, clicked, bounced, unsubscribed, complained
  ipAddress     String?
  userAgent     String?
  occurredAt    DateTime @default(now())

  @@index([organizationId])
  @@index([campaignId])
  @@index([contactId])
  @@index([type])
  @@index([occurredAt])
}

// --------------------------------------------------------------------------
// Campaign Recipients
// --------------------------------------------------------------------------

model CampaignRecipient {
  id             String   @id @default(uuid()) @db.Uuid
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String   @db.Uuid
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String   @db.Uuid
  status         String   @default("pending") // pending, sent, delivered, opened, clicked, bounced, failed
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([campaignId])
  @@index([contactId])
  @@index([status])
}

// --------------------------------------------------------------------------
// Automation Workflows
// --------------------------------------------------------------------------

model AutomationWorkflow {
  id            String      @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String     @db.Uuid
  name          String
  description   String?
  status        String      @default("draft") // draft, active, paused, completed
  triggerType   String      // contact_created, form_submission, tag_added, lead_status_changed, campaign_event
  triggerConfig Json        @default("{}")
  isActive      Boolean     @default(false)
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdById   String      @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  nodes         WorkflowNode[]
  executions    WorkflowExecution[]

  @@index([organizationId])
  @@index([status])
  @@index([isActive])
}

model WorkflowNode {
  id            String   @id @default(uuid()) @db.Uuid
  workflow      AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId    String   @db.Uuid
  type          String   // trigger, action, condition, delay, webhook
  nodeType      String   // send_email, add_tag, update_contact, assign_lead, wait, condition_if, etc.
  config        Json     @default("{}")
  positionX     Int      @default(0)
  positionY     Int      @default(0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([workflowId])
}

model WorkflowExecution {
  id             String   @id @default(uuid()) @db.Uuid
  workflow       AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId     String   @db.Uuid
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId      String?  @db.Uuid
  status         String   @default("running") // running, completed, failed, cancelled
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  errorMessage   String?
  triggerEventId String?  // idempotency key to prevent duplicate execution
  createdAt      DateTime @default(now())

  @@index([workflowId])
  @@index([contactId])
  @@index([status])
  @@index([triggerEventId])
}

// --------------------------------------------------------------------------
// Integrations
// --------------------------------------------------------------------------

model Integration {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  provider      String   // sendgrid, mailgun, aws_ses, smtp, slack, etc.
  name          String
  config        Json     @default("{}") // encrypted sensitive fields at rest
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId])
  @@index([provider])
}

// --------------------------------------------------------------------------
// Notifications
// --------------------------------------------------------------------------

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @db.Uuid
  title         String
  message       String
  type          String   // info, success, warning, error
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}

// --------------------------------------------------------------------------
// Audit Logs
// --------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?  @db.Uuid
  action        String   // create, update, delete, login, logout, send_email, etc.
  entity        String   // e.g. Contact, Campaign, Workflow
  entityId      String?
  metadata      Json     @default("{}")
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
